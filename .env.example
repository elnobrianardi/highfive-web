# Public origin used for canonical URLs, Open Graph images, JSON-LD @id values,
# sitemap.xml and robots.txt. No trailing slash.
#
# Leave this unset on Vercel: VERCEL_URL is used automatically, and preview
# deployments are automatically marked noindex + Disallow: /.
#
# Set it explicitly for production once the real domain is known.
NEXT_PUBLIC_SITE_URL=https://highfive-web-azure.vercel.app
